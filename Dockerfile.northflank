FROM node:22.23.4-bookworm-slim@sha256:eb37f58646a901dc7727cf448cae36daaefaba79de33b5058dab79aa4c04aefb
WORKDIR /app
RUN corepack enable
COPY package.json pnpm-lock.yaml ./
COPY patches ./patches
RUN pnpm install --frozen-lockfile
COPY . .
RUN pnpm build:api
ARG APP_REVISION
RUN echo "$APP_REVISION" | grep -Eq '^[0-9a-f]{40}$'
ENV APP_REVISION=$APP_REVISION NODE_ENV=production API_ONLY=true PORT=3000
USER node
EXPOSE 3000
CMD ["node", "dist/index.js"]
