FROM node:22.23.4-bookworm-slim@sha256:5991875dfb80938dd8a6ba3fe3e96fd04929e70792762b3319d8caadbbe229bc
WORKDIR /app
RUN corepack enable
COPY package.json pnpm-lock.yaml ./
COPY patches ./patches
RUN pnpm install --frozen-lockfile
COPY . .
RUN pnpm build:api
ARG APP_REVISION
RUN echo "$APP_REVISION" | grep -Eq '^[0-9a-f]{40}$'
ENV APP_REVISION=$APP_REVISION NODE_ENV=production API_ONLY=true PORT=3000
USER node
EXPOSE 3000
CMD ["node", "dist/index.js"]
