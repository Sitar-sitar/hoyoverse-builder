# Northflank production API example; never commit real credentials.
NODE_ENV=production
PORT=3000
API_ONLY=true
CORS_ORIGINS=https://sitar-sitar.github.io

# Private MySQL URL: mysql://<user>:<encoded-password>@<internal-host>:3306/<database>
DATABASE_URL=
# Mount this runtime secret file separately on the API and migration Job.
DATABASE_SSL_CA_FILE=/secrets/mysql-ca.pem

# GitHub App administrator authentication.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_CALLBACK_URL=https://http--hoyoverse-api--s48krvgv8tjs.code.run/api/auth/github/callback
ADMIN_GITHUB_IDS=
ADMIN_SESSION_SECRET=
ADMIN_FRONTEND_URL=https://sitar-sitar.github.io/hoyoverse-builder/app

# Measured for this deployment only; remeasure in other environments.
CLIENT_IP_SOURCE=northflank
NORTHFLANK_TRUSTED_PROXY_HOPS=1
API_MAINTENANCE=false
API_MIGRATION_PREVIEW=false
# Set the Docker build argument to the exact 40-character release commit SHA.
APP_REVISION=

# Local development: use local DB/CA configuration and socket IP mode.
# Optional legacy Manus full-stack settings, unused by production API-only runtime.
VITE_APP_ID=
JWT_SECRET=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
