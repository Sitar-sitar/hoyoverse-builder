# External API deployment
API_ONLY=true
CORS_ORIGINS=https://sitar-sitar.github.io

# Enables analytics, feedback, and administrator user storage.
# Railway MySQL exposes MYSQL_URL; set DATABASE_URL to the same value.
DATABASE_URL=

# GitHub App administrator authentication.
# Register the callback URL below in the GitHub App settings.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_CALLBACK_URL=https://hoyoverse-builder-api-production.up.railway.app/api/auth/github/callback
ADMIN_GITHUB_IDS=
ADMIN_SESSION_SECRET=
ADMIN_FRONTEND_URL=https://sitar-sitar.github.io/hoyoverse-builder

# Optional Manus-era variables used only by the original full-stack runtime.
VITE_APP_ID=
JWT_SECRET=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Migration runtime (unset values preserve Railway behavior).
CLIENT_IP_SOURCE=auto
# Required only for northflank; set after measuring the real proxy chain.
NORTHFLANK_TRUSTED_PROXY_HOPS=
API_MAINTENANCE=false
API_MIGRATION_PREVIEW=false
APP_REVISION=
# CA certificate file mounted at runtime, used by API and migration job.
DATABASE_SSL_CA_FILE=
